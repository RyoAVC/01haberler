# --- Uygulama ---
NODE_ENV=development

# Optional newsletter: verified Resend sender. Empty values disable subscriptions.
RESEND_API_KEY=
NEWSLETTER_FROM=
APP_URL=http://localhost:3000
APP_NAME="01 Haberler"

# --- Veritabani (PostgreSQL) ---
# Kendi sunucunuzda/Docker'da tek bir DATABASE_URL yeterlidir, DIRECT_URL'i bos birakabilirsiniz.
# Supabase gibi pgbouncer/pooler kullanan saglayicilarda: DATABASE_URL = transaction pooler
# (calisma zamani sorgulari icin, cok sayida kisa baglanti destekler), DIRECT_URL = dogrudan/session
# baglanti (yalnizca `prisma migrate`/`db push` bunu kullanir). Ayrinti: https://pris.ly/d/pooling
DATABASE_URL="postgresql://haberler:changeme@localhost:5432/haberler01?schema=public"
DIRECT_URL="postgresql://haberler:changeme@localhost:5432/haberler01?schema=public"

# --- Redis (cache + BullMQ kuyruk) ---
REDIS_URL="redis://localhost:6379"

# --- Oturum / Guvenlik ---
# 32+ byte rastgele deger uretin: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48"
COOKIE_NAME="01h_session"
# Sadece production'da true olmali (HTTPS zorunlu)
COOKIE_SECURE=false

# --- Dosya yukleme ---
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB=5

# --- Disaridan gorsel cekimi icin izinli domain listesi (virgulle ayirin) ---
IMAGE_ALLOWLIST_DOMAINS=""

# --- Ingestion / Bot ---
INGESTION_CONCURRENCY=2
INGESTION_DEFAULT_INTERVAL_MINUTES=15
INGESTION_REQUEST_TIMEOUT_MS=10000
INGESTION_USER_AGENT="01HaberlerBot/1.0 (+https://01haberler.com/bot)"

# --- Reklam (AdSense / Google Ad Manager) ---
# Gercek deger yalnizca kendi hesabinizdan alinir; bos birakilirsa reklam alanlari test/placeholder modunda calisir.
ADSENSE_PUBLISHER_ID=""
ADSENSE_ENABLED=false
GAM_NETWORK_CODE=""

# --- Google Consent Mode / Analytics (opsiyonel) ---
GA_MEASUREMENT_ID=""

# --- Yapay zeka ozetleme/otomatik yayin modulu (opsiyonel, varsayilan kapali) ---
# Otomatik yayin icin: AI_SUMMARY_ENABLED=true, PROVIDER=gemini veya anthropic, gecerli API_KEY.
# Ayrica /admin/moduller'de "AI Kaynak Duzenleme + Otomatik Yayin" acilmali ve
# kaynak "guvenilir" isaretlenmeli.
AI_SUMMARY_ENABLED=false
AI_SUMMARY_PROVIDER=""
AI_SUMMARY_API_KEY=""
# Bos = saglayici varsayilani (gemini -> gemini-flash-latest, anthropic -> claude-haiku-4-5)
AI_SUMMARY_MODEL=""

# --- Ucretsiz stok gorsel API'si (opsiyonel) - pexels.com/api uzerinden alinir ---
PEXELS_API_KEY=""

# --- Cron ile tetiklenen ingestion endpoint'i (paylasimli hosting icin) ---
# BullMQ worker'i surekli calistiramayan ortamlarda /api/cron/ingestion
# endpoint'ini harici bir cron ile (ornegin her 15 dakikada) tetikleyin:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://siteniz.com/api/cron/ingestion
CRON_SECRET=""

# --- Bakim modu ---
# true yapildiginda /admin ve /api disindaki tum sayfalar /bakim'e yonlendirilir.
MAINTENANCE_MODE=false

# --- Web Push (VAPID) ---
# Bir kez uretin: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@01haberler.com"
